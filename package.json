{
  "name": "@nilsr0711/drydock",
  "version": "1.2.1",
  "type": "module",
  "description": "Local-first tool that autonomously turns GitHub issues into pull requests via the Claude CLI, startable from the terminal with `npx @nilsr0711/drydock`.",
  "keywords": [
    "github",
    "issues",
    "pull-requests",
    "automation",
    "ai",
    "claude",
    "agent",
    "cli",
    "nextjs"
  ],
  "license": "MIT",
  "homepage": "https://github.com/NilsR0711/drydock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NilsR0711/drydock.git"
  },
  "bugs": {
    "url": "https://github.com/NilsR0711/drydock/issues"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "bin",
    ".next/standalone",
    ".next/static",
    "drizzle"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack && node scripts/package-standalone.mjs && node scripts/package-mcp.mjs",
    "start": "next start -H 127.0.0.1 -p 3737",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:daemon": "vitest run tests/control-shutdown.test.ts tests/cli-daemon.test.ts tests/daemon-lifecycle.integration.test.ts",
    "smoke": "node scripts/smoke-standalone.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "backup": "tsx scripts/backup.ts",
    "db:prune": "tsx scripts/prune.ts",
    "mcp": "tsx scripts/drydock.ts mcp",
    "desktop:install": "npm --prefix desktop install",
    "tauri:dev": "npm --prefix desktop run dev",
    "tauri:build": "npm --prefix desktop run build",
    "prepublishOnly": "pnpm test && pnpm build && pnpm smoke && pnpm smoke:mcp"
  },
  "bin": {
    "drydock": "bin/drydock.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^5.0.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "monaco-editor": "^0.55.1",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.12.3",
    "recharts": "^3.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.9",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "@biomejs/biome",
      "sharp"
    ],
    "overrides": {
      "dompurify": ">=3.4.9"
    }
  }
}
