{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drydock",
  "version": "0.1.9",
  "identifier": "dev.nilsreeh.drydock",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Drydock",
        "url": "http://127.0.0.1:3737/",
        "width": 1200,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "visible": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Menu-bar shell for the Drydock dashboard.",
    "longDescription": "A native macOS menu-bar shell that wraps the local Drydock dashboard and surfaces live job counts with quick pause/resume and drain toggles from the tray.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
